# MiniKernel Production Configuration
# Optimized for deployment with security hardening

# Target architecture
BR2_x86_64=y
BR2_x86_corei7=y

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="minikernel"
BR2_TARGET_GENERIC_ISSUE="MiniKernel v1.0"
BR2_TARGET_GENERIC_ROOT_PASSWD_HASH="$6$rounds=5000$..."  # Change this!
BR2_SYSTEM_DHCP="eth0"

# Kernel - hardened
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MINIKERNEL_PATH)/kernel_hardened.config"

# Filesystem - optimized
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2048M"
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# Bootloader
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y

# Init system
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BASH=y

# Toolchain - optimized
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_ENABLE_LTO=y
BR2_OPTIMIZE_3=y
BR2_SSP_STRONG=y
BR2_RELRO_FULL=y

# Python 3 - production
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_SETUPTOOLS=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_SQLITE=y

# Minimal packages
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_E2FSPROGS=y

# Networking - secured
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Audio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_PULSEAUDIO=y

# Security
BR2_PACKAGE_FAIL2BAN=y
BR2_PACKAGE_IPTABLES=y

# VirtualBox
BR2_PACKAGE_VIRTUALBOX_GUEST_ADDITIONS=y

# Strip binaries
BR2_STRIP_strip=y
BR2_STRIP_EXCLUDE_FILES=""

# No debug symbols in production
