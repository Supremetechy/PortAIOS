# MiniKernel Minimal Configuration
# Smallest possible bootable system (~200 MB)

# Target architecture
BR2_x86_64=y

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="minikernel-minimal"
BR2_TARGET_GENERIC_ISSUE="MiniKernel Minimal"
BR2_TARGET_GENERIC_ROOT_PASSWD="minikernel"

# Kernel - minimal
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"

# Filesystem - smaller
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"
BR2_TARGET_ROOTFS_ISO9660=y

# Bootloader
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y

# Init - busybox only (no systemd)
BR2_INIT_BUSYBOX=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Python 3 - minimal
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y

# Bare minimum packages
BR2_PACKAGE_BUSYBOX=y

# No GUI, audio, or heavy packages
