# MiniKernel Developer Configuration
# Includes development tools, debugging, and full featured system

# Target architecture
BR2_x86_64=y
BR2_x86_corei7=y

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="minikernel-dev"
BR2_TARGET_GENERIC_ISSUE="MiniKernel Developer Edition"
BR2_TARGET_GENERIC_ROOT_PASSWD="minikernel"
BR2_SYSTEM_DHCP="eth0"

# Kernel with debug symbols
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MINIKERNEL_PATH)/kernel.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Larger filesystem for development
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="4096M"
BR2_TARGET_ROOTFS_ISO9660=y

# Bootloader
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y

# Init system
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BASH=y

# Toolchain with debugging
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_ENABLE_LTO=y
BR2_ENABLE_DEBUG=y
BR2_DEBUG_3=y

# Python 3 with full features
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_SETUPTOOLS=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_SQLITE=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_CURSES=y

# Development tools
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
BR2_PACKAGE_GDB_DEBUGGER=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_LTRACE=y
BR2_PACKAGE_VALGRIND=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_GCC=y
BR2_PACKAGE_GCC_TARGET=y
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_CMAKE=y
BR2_PACKAGE_AUTOCONF=y
BR2_PACKAGE_AUTOMAKE=y
BR2_PACKAGE_LIBTOOL=y

# Version control
BR2_PACKAGE_GIT=y
BR2_PACKAGE_GIT_CONTRIB=y

# Editors
BR2_PACKAGE_VIM=y
BR2_PACKAGE_NANO=y

# Networking - full stack
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_IPERF3=y

# Audio - full support
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACONF=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_PULSEAUDIO_DAEMON=y

# Compression
BR2_PACKAGE_XZ=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_ZIP=y
BR2_PACKAGE_UNZIP=y

# System utilities
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_SCREEN=y

# Filesystem tools
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_FUSE=y

# VirtualBox
BR2_PACKAGE_VIRTUALBOX_GUEST_ADDITIONS=y
