# MiniKernel Buildroot Configuration
# Minimal bootable Linux system with Python and LLM support

# Target architecture
BR2_x86_64=y
BR2_x86_corei7=y

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="minikernel"
BR2_TARGET_GENERIC_ISSUE="Welcome to MiniKernel - AI-First Voice OS"
BR2_TARGET_GENERIC_ROOT_PASSWD="minikernel"
BR2_SYSTEM_DHCP="eth0"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MINIKERNEL_PATH)/kernel.config"

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2048M"
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_MINIKERNEL_PATH)/isolinux.cfg"

# Bootloader
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y
BR2_TARGET_SYSLINUX_MBR=y

# Init system
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BASH=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_ENABLE_LTO=y

# Python 3
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_SETUPTOOLS=y

# Python packages
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_SQLITE=y

# System utilities
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y

# Networking
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CURL=y

# Audio support for TTS/STT
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_PULSEAUDIO=y

# Development tools
BR2_PACKAGE_GDB=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_FILE=y

# Compression
BR2_PACKAGE_XZ=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_BZIP2=y

# VirtualBox Guest Additions support
BR2_PACKAGE_VIRTUALBOX_GUEST_ADDITIONS=y

# Additional filesystem support
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_FUSE=y

# Kernel modules for VirtualBox
BR2_LINUX_KERNEL_EXT_VIRTUALBOX_GUEST_DRIVER=y
