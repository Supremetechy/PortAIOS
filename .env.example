# PortAIOS Environment Configuration
# Copy this file to .env and fill in your API keys

# DeepGram API Key (for voice agent: STT + LLM + TTS)
# Get your API key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: OpenAI API Key (if using OpenAI as the "think" provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API Key (if using Claude as the "think" provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google API Key (if using Gemini as the "think" provider)
# GOOGLE_API_KEY=your_google_api_key_here

# Server Mode
# Set to 1 for headless/Docker deployments
# AIOS_HEADLESS=0
