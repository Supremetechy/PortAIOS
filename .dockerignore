# =============================================================================
# PortAIOS — Docker Build Context Exclusions
# =============================================================================

# Version control
.git
.gitignore
.gitattributes

# Python virtual environments & caches
.venv
venv
.build-venv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
*.egg-info
.eggs

# Build & distribution artifacts
build/
dist/

# Node / JS tooling
node_modules/
package-lock.json

# Secrets & local config
.env
.env.*
*.local

# Large model binaries — mount as a volume at runtime instead
# (keeps the image lean; pre-download to ./models/ on the host)
models/*.glb
models/*.gguf
models/*.bin
models/*.onnx

# IDE & OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
Icon

# Logs
*.log
logs/

# Test / development artefacts
test_*.py
test_*.html
*_test.py
tests/

# Documentation (not needed inside the container)
docs/
*.md
IMPLEMENTATION*.txt
QUICKSTART*.md
VERTICAL_INTEGRATION*.md
VOICE_COMMANDS*.md
Context.md
TODO.md

# PyInstaller output (not needed for Docker)
installer/windows/
installer/linux/
installer/macos/
installer/icons/
installer/__pycache__/

# Excess / archived web files already removed from tree
web/excess/
